<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SimpleVpn.Desktop.Views"
        xmlns:loc="using:SimpleVpn.App.Localization"
        x:Class="SimpleVpn.Desktop.Views.MainWindow"
        Title="{loc:Loc AppTitle}"
        Icon="avares://SimpleVpn/Assets/app.ico"
        Width="420" Height="660"
        MinWidth="360" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <views:MainView />
</Window>
