<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SimpleVpn.Desktop</RootNamespace>
    <AssemblyName>SimpleVpn</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\*.ico" />
    <AvaloniaResource Include="Assets\flags\*.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimpleVpn.App\SimpleVpn.App.csproj" />
  </ItemGroup>

  <!-- Xray binaries and seed geo files fetched by tools/fetch-xray.ps1 (not in git). -->
  <ItemGroup>
    <None Include="..\..\assets\core\**" Link="core\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\geo\**" Link="geo\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Native SkiaSharp/HarfBuzz .pdb files from NuGet add ~100 MB; end users don't need any symbols. -->
  <Target Name="RemovePublishedSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdb)" />
  </Target>

  <Target Name="WarnMissingXray" BeforeTargets="Build" Condition="!Exists('..\..\assets\core\xray.exe')">
    <Warning Text="assets/core/xray.exe not found. Run tools/fetch-xray.ps1 to download the Xray core." />
  </Target>
</Project>
