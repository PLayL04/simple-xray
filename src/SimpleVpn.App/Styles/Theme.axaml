<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PowerOffBrush" Color="#E3E6EB" />
          <SolidColorBrush x:Key="PowerOffForegroundBrush" Color="#5B6472" />
          <SolidColorBrush x:Key="CardBrush" Color="#F4F5F7" />
          <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PowerOffBrush" Color="#2E333B" />
          <SolidColorBrush x:Key="PowerOffForegroundBrush" Color="#AEB6C2" />
          <SolidColorBrush x:Key="CardBrush" Color="#23272E" />
          <SolidColorBrush x:Key="DialogBrush" Color="#2B2F36" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="PowerOnBrush" Color="#2BA866" />
      <SolidColorBrush x:Key="PowerOnForegroundBrush" Color="#FFFFFF" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Big round connect button -->
  <Style Selector="Button.power">
    <Setter Property="Width" Value="148" />
    <Setter Property="Height" Value="148" />
    <Setter Property="CornerRadius" Value="74" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource PowerOffBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PowerOffForegroundBrush}" />
  </Style>
  <Style Selector="Button.power.connected">
    <Setter Property="Background" Value="{DynamicResource PowerOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PowerOnForegroundBrush}" />
  </Style>
  <Style Selector="Button.power:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PowerOffBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PowerOffForegroundBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.power.connected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PowerOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PowerOnForegroundBrush}" />
  </Style>

  <!-- Rows with server / routing preset under the button -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- Modal panel over the main screen -->
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #40000000" />
  </Style>
</Styles>
