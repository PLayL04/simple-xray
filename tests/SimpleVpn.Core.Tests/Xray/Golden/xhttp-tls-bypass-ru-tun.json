{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {
        "name": "SimpleVpn",
        "desc": "SimpleVpn",
        "mtu": 1500,
        "gateway": [
          "172.19.0.1/30",
          "fdfe:dcba:9876::1/126"
        ],
        "dns": [
          "172.19.0.2"
        ],
        "autoSystemRoutingTable": [
          "0.0.0.0/0",
          "::/0"
        ],
        "autoOutboundsInterface": "auto",
        "autoSystemWfpBlockLeak": [
          "dns"
        ]
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    },
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10888,
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 10889,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "vpn.example.com",
            "port": 443,
            "users": [
              {
                "id": "0b5c2a8e-6f1d-4c3a-9e2b-7d4f8a1c3e5b",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "xhttpSettings": {
          "host": "vpn.example.com",
          "path": "/xh",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000"
          }
        },
        "tlsSettings": {
          "serverName": "vpn.example.com",
          "fingerprint": "chrome",
          "alpn": [
            "h2",
            "http/1.1"
          ]
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    }
  ],
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query",
      {
        "address": "localhost",
        "domains": [
          "geosite:ru-available-only-inside",
          "geosite:category-ru"
        ],
        "skipFallback": true
      }
    ],
    "queryStrategy": "UseIPv4",
    "tag": "dns-module"
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "tun-in"
        ],
        "port": "53",
        "outboundTag": "dns-out"
      },
      {
        "inboundTag": [
          "dns-module"
        ],
        "outboundTag": "proxy"
      },
      {
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:ru-available-only-inside"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:ru-blocked"
        ],
        "outboundTag": "proxy"
      },
      {
        "domain": [
          "geosite:category-ru"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:ru-blocked"
        ],
        "outboundTag": "proxy"
      },
      {
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}